# SafeX Environment Variables Scaffold

# Node.js Backend
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key
DATABASE_URL=postgresql://safex_user:safex_pass@localhost:5432/safex_db
REDIS_URL=redis://localhost:6379

# FastAPI AI Service
AI_SERVICE_PORT=8000
