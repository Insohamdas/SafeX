MODEL_WEIGHTS_PATH=./weights/crowd_density.pt

# Mobile & Web APIs
API_BASE_URL=http://localhost:5000/api/v1
SOCKET_SERVER_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:8000
